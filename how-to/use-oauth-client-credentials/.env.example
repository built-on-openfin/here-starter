# Copy this file to `.env` and fill in your values. `.env` is git-ignored.
#
#   cp .env.example .env
#
# Real environment variables already set in the shell take precedence over this
# file, so a scheduler or CI job can inject them directly instead.

# Your HERE domain, no trailing slash.
BASE_URL=https://my-org.is.here.io

# The client id of the OAuth app you registered in the Admin Console under
# Admin > OAuth Apps, as a Confidential client with the
# Client Credentials grant enabled. See the README for the full setup.
HERE_CLIENT_ID=

# A client secret created on that app. It is shown once, when you create it.
# Treat it like a password: keep it in your secret store, never in source
# control, and rotate it before the expiry date you chose when creating it.
HERE_CLIENT_SECRET=

# --- Optional: pull-audit settings ---

# How far back the first run looks, in minutes, when there is no saved
# watermark yet. Later runs carry on from where the previous run stopped.
# AUDIT_LOOKBACK_MINUTES=15

# How many seconds behind "now" each window stops. Leaves time for records
# that are still being written to land before their window is read.
# AUDIT_SETTLE_SECONDS=60

# Where records and the watermark are written. Defaults to ./output.
# AUDIT_OUTPUT_DIR=./output
