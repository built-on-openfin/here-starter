# Copy this file to `.env` and fill in your values. `.env` is git-ignored.
#
#   cp .env.example .env
#
# The guided UI and the sync script authenticate differently, so they don't read the same
# variables from here — see which "Used by" section each one falls under before assuming a value
# is picked up by both. BASE_URL is the one exception both share.

# Your HERE domain, no trailing slash. Used by both the UI and the script.
BASE_URL=https://my-org.here.io

# --- Browser UI: OAuth (used by the UI only) ---
#
# The client id of the OAuth app registered in your HERE admin console under
# Admin -> OAuth Apps. This is not a secret: it is public by design, and the UI
# signs in with authorization code + PKCE so no secret is ever needed in the
# browser. See the README for how to register the app.
#
# This value IS baked into the UI bundle at build time, so re-run `npm run
# build` (or `npm run start`, which builds first) after changing it.
HERE_OAUTH_CLIENT_ID=

# --- Sync script: API JWT (used by the script only) ---
#
# The script runs headless, with no user to redirect through a sign-in, so it
# uses an API JWT issued for your org instead. How tokens are issued depends on
# your organization's authentication setup; ask your HERE administrator. Treat
# it as a secret.
#
# This value is read by the script at runtime and is NOT baked into the UI
# bundle — setting it here does nothing for the browser UI. If OAuth isn't set
# up yet and you want to try the UI anyway, paste the same JWT directly into
# the "Paste API JWT" field next to Sign in instead; see the README section
# "Signing in with a JWT instead of OAuth".
HERE_API_JWT=

# The id of the authentication provider to validate that JWT against, sent as
# the x-of-auth-id header. The API docs call this required only when your org
# has more than one provider configured — in practice, set it whenever your
# administrator gives you one. We hit an org that rejected requests with
# NOT_AUTHENTICATED until this was set, despite appearing to have only one
# provider. If HERE_API_JWT alone gets NOT_AUTHENTICATED, this is the first
# thing to check.
#
# Same runtime-only caveat as HERE_API_JWT: this is read by the script, not
# baked into the UI bundle. The UI has its own "Auth ID" field next to "Paste
# API JWT" for the same value.
HERE_AUTH_ID=

# A here-session cookie value — an alternative for the sync script only (Node),
# never the browser UI. Copy it while logged into the Admin Console: developer
# tools -> Application -> Cookies -> here-session.
# HERE_SESSION=
